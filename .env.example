# Copy to .env and fill in. Never commit .env.
BASE_URL=https://ipasstage.iitgn.ac.in/
LOGIN_PATH=/
# Optional: direct PPRF form URL. Leave blank - setup finds it via MM -> STORES -> PPRF.
PPRF_PATH=
PPRF_USER=rnd.ja
PPRF_PASSWORD=

# Expected indenter details for rnd.ja (TC_039)
EXPECTED_EMP_ID=E0023

# TC_030 creates a real submitted PPRF on staging. Keep false unless you intend that.
RUN_SUBMIT=false

# TC_032: label of a PPRF in the "Saved PPRF" dropdown that was created BEFORE the hot-fix
OLD_PPRF_LABEL=

# ---- Travelling Allowance Claim ----
# Optional: direct TA form URL. Leave blank - setup finds it via General -> Individual -> Claims -> Travelling Allowance.
TA_PATH=
# TA_027: eOffice Leave Receipt to use when saving a claim. Blank = first one in the dropdown.
TA_RECEIPT_LABEL=
